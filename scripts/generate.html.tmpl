<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resume · Kenneth Chen Ko Han</title>
  <style>
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html, body { margin: 0; height: 100%; background: #fff; color: #171717;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 15px; line-height: 1.5; }

    /* ── password screen: barebones ─────────────────────────────── */
    .lock { min-height: 100vh; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 10px; padding: 24px; }
    .lock form { display: flex; gap: 8px; }
    .lock input { font: inherit; padding: 8px 10px; border: 1px solid #ccc; border-radius: 6px; }
    .lock button { font: inherit; padding: 8px 14px; border: 0; border-radius: 6px;
      background: #171717; color: #fff; cursor: pointer; }
    .lock button:hover { opacity: .88; }
    #err { margin: 0; min-height: 18px; color: #b42318; font-size: 14px; }

    /* ── PDF viewer ─────────────────────────────────────────────── */
    .viewer { display: flex; flex-direction: column; height: 100vh; }
    .bar { display: flex; gap: 8px; justify-content: center; align-items: center;
      padding: 8px; border-bottom: 1px solid #e8e8e6; background: #fafafa; }
    .bar a, .bar button { font: inherit; padding: 6px 14px; border: 1px solid #ccc;
      border-radius: 6px; background: #fff; cursor: pointer; text-decoration: none; color: inherit; }
    .bar .primary { background: #171717; color: #fff; border-color: #171717; }
    .viewer iframe { flex: 1; width: 100%; border: 0; }
  </style>
</head>
<body>
  <div class="lock" id="lock">
    <form id="lockform">
      <input id="pw" type="password" placeholder="Password" autocomplete="off" autofocus aria-label="Password">
      <button type="submit">Unlock</button>
    </form>
    <p id="err" hidden></p>
  </div>

  <div class="viewer" id="viewer" hidden>
    <div class="bar">
      <a class="primary" id="dl" download="kenneth-chen-ko-han-resume.pdf" target="_blank" rel="noreferrer">Download PDF</a>
      <button onclick="location.reload()">Lock</button>
    </div>
    <iframe id="pdf" title="Resume PDF"></iframe>
  </div>

<script>
const b64ToBytes = (s) => {
  const bin = atob(s); const a = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i += 1) a[i] = bin.charCodeAt(i);
  return a;
};
// AES-GCM in Web Crypto wants ciphertext || tag concatenated (Node's cipher
// API takes the tag separately). flatMap must spread into arrays to flatten.
const cat = (...b64) => Uint8Array.from(b64.flatMap((s) => [...b64ToBytes(s)]));

async function unlock(event) {
  event.preventDefault();
  const pw = document.getElementById("pw").value;
  const err = document.getElementById("err");
  err.hidden = true;
  if (!pw) return;

  let blob;
  try {
    const res = await fetch("resume.enc.json");
    if (!res.ok) throw new Error("load");
    blob = await res.json();
  } catch {
    err.hidden = false; err.textContent = "Could not load resume.";
    return;
  }

  let bytes;
  try {
    const material = await crypto.subtle.importKey(
      "raw", new TextEncoder().encode(pw), "PBKDF2", false, ["deriveBits"]);
    const bits = await crypto.subtle.deriveBits(
      { name: "PBKDF2", salt: b64ToBytes(blob.salt), iterations: blob.iterations, hash: "SHA-256" },
      material, 256);
    const key = await crypto.subtle.importKey("raw", bits, { name: "AES-GCM" }, false, ["decrypt"]);
    bytes = await crypto.subtle.decrypt(
      { name: "AES-GCM", iv: b64ToBytes(blob.nonce) }, key, cat(blob.ciphertext, blob.tag));
  } catch {
    err.hidden = false; err.textContent = "Wrong password.";
    return;
  }

  // Turn the decrypted PDF bytes into a blob URL and show it in the viewer.
  const url = URL.createObjectURL(new Blob([bytes], { type: "application/pdf" }));
  document.getElementById("pdf").src = url;
  document.getElementById("dl").href = url;
  document.getElementById("lock").hidden = true;
  document.getElementById("viewer").hidden = false;
}

document.getElementById("lockform").addEventListener("submit", unlock);
</script>
</body>
</html>
