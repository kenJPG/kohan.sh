<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resume · Kenneth Chen Ko Han</title>
  <style>
    * { box-sizing: border-box; }
    html, body { margin: 0; background: #fff; color: #171717;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 15px; line-height: 1.5; }

    /* ── password screen: barebones ─────────────────────────────── */
    .lock { min-height: 100vh; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 10px; padding: 24px; }
    .lock form { display: flex; gap: 8px; }
    .lock input { font: inherit; padding: 8px 10px; border: 1px solid #ccc; border-radius: 6px; }
    .lock button { font: inherit; padding: 8px 14px; border: 0; border-radius: 6px;
      background: #171717; color: #fff; cursor: pointer; }
    .lock button:hover { opacity: .88; }
    #err { margin: 0; min-height: 18px; color: #b42318; font-size: 14px; }

    /* ── toolbar (not printed) ──────────────────────────────────── */
    .bar { display: flex; gap: 8px; justify-content: center; padding: 10px;
      border-bottom: 1px solid #e8e8e6; }
    .bar button { font: inherit; padding: 6px 14px; border: 1px solid #ccc;
      border-radius: 6px; background: #fff; cursor: pointer; }
    .bar .primary { background: #171717; color: #fff; border-color: #171717; }

    /* ── resume ─────────────────────────────────────────────────── */
    .resume { max-width: 820px; margin: 0 auto; padding: 24px 32px 48px; }
    .resume h1 { font-size: 24px; margin: 0; }
    .contact { list-style: none; padding: 0; margin: 6px 0 0; display: flex;
      flex-wrap: wrap; gap: 4px 10px; font-size: 13px; color: #444; }
    .contact li::after { content: "·"; margin-left: 10px; color: #bbb; }
    .contact li:last-child::after { content: ""; }
    .resume section { border-top: 1px solid #e8e8e6; padding-top: 12px; margin-top: 12px; }
    .resume h2 { font-size: 12px; text-transform: uppercase; letter-spacing: .06em;
      color: #6b6b6b; margin: 0 0 8px; }
    .job { margin-bottom: 10px; }
    .job__top { display: flex; justify-content: space-between; gap: 12px; }
    .job__role { font-weight: 600; margin: 0; }
    .job__org { margin: 1px 0 0; font-size: 13px; color: #666; }
    .job__date { font-size: 12px; color: #6b6b6b; white-space: nowrap; }
    .job__body { margin: 4px 0 0; }
    .tags { list-style: none; padding: 0; margin: 5px 0 0; display: flex; flex-wrap: wrap; gap: 3px 8px; }
    .tags li { font-size: 11.5px; color: #6b6b6b; }
    a { color: inherit; text-decoration: none; border-bottom: 1px solid #ccc; }

    @media print {
      .bar, .lock { display: none !important; }
      body { font-size: 11.5px; }
      .resume { max-width: none; padding: 0; }
      .job { break-inside: avoid; }
      @page { size: A4; margin: 12mm 14mm; }
    }
  </style>
</head>
<body>
  <div class="bar" id="bar" hidden>
    <button class="primary" onclick="window.print()">Print / Save PDF</button>
    <button onclick="location.reload()">Lock</button>
  </div>

  <div class="lock" id="lock">
    <form id="lockform">
      <input id="pw" type="password" placeholder="Password" autocomplete="off" autofocus aria-label="Password">
      <button type="submit">Unlock</button>
    </form>
    <p id="err" hidden></p>
  </div>

  <article class="resume" id="resume" hidden></article>

<script>
// Injected by scripts/generate.mjs (single source of truth = content.json).
const RESUME = @@RESUME_DATA@@;

const enc = (s) => String(s == null ? "" : s)
  .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const link = (label, url) => `<a href="${enc(url)}" rel="noreferrer" target="_blank">${enc(label)}</a>`;

// Accepts a comma-separated string OR an array - experience `tech` and
// education `coursework` arrive as strings, skills values as strings too.
const tags = (v) => {
  const arr = Array.isArray(v) ? v : String(v || "").split(",");
  return arr.map((t) => t.trim()).filter(Boolean).map((t) => `<li>${enc(t)}</li>`).join("");
};

const b64ToBytes = (s) => {
  const bin = atob(s); const a = new Uint8Array(bin.length);
  for (let i = 0; i < bin.length; i += 1) a[i] = bin.charCodeAt(i);
  return a;
};
// AES-GCM in Web Crypto wants ciphertext || tag concatenated (Node's cipher
// API takes the tag separately). flatMap must spread into arrays to flatten.
const cat = (...b64) => Uint8Array.from(b64.flatMap((s) => [...b64ToBytes(s)]));

function renderExperience(list) {
  return list.map((e) => `<div class="job">
    <div class="job__top">
      <div>
        <p class="job__role">${enc(e.role)}</p>
        <p class="job__org">${e.url ? link(e.company, e.url) : enc(e.company)}</p>
      </div>
      <span class="job__date">${enc(e.date)}</span>
    </div>
    ${e.description ? `<p class="job__body">${enc(e.description)}</p>` : ""}
    ${e.tech ? `<ul class="tags">${tags(e.tech)}</ul>` : ""}
  </div>`).join("");
}

function renderResearch(list) {
  return list.map((e) => `<div class="job">
    <div class="job__top">
      <p class="job__role">${enc(e.title)}</p>
      <span class="job__date">${enc(e.org)}</span>
    </div>
    ${e.detail ? `<p class="job__body">${enc(e.detail)}</p>` : ""}
  </div>`).join("");
}

function renderEducation(list) {
  return list.map((e) => `<div class="job">
    <div class="job__top">
      <div>
        <p class="job__role">${enc(e.school)}</p>
        <p class="job__org">${enc(e.degree)}</p>
      </div>
      <span class="job__date">${enc(e.date)}</span>
    </div>
    ${e.gpa ? `<p class="job__body">GPA ${enc(e.gpa)}</p>` : ""}
    ${e.awards ? `<p class="job__body">${enc(e.awards)}</p>` : ""}
    ${e.coursework ? `<ul class="tags">${tags(e.coursework)}</ul>` : ""}
  </div>`).join("");
}

function renderSkills(skills) {
  return Object.entries(skills).map(([label, value]) =>
    `<div class="job"><p class="job__org">${enc(label)}</p><ul class="tags">${tags(value)}</ul></div>`
  ).join("");
}

function showResume(c) {
  const r = RESUME;
  const contact = [
    c.phone ? `<li><strong>${enc(c.phone)}</strong></li>` : "",
    c.email ? `<li>${link(c.email, "mailto:" + c.email)}</li>` : "",
    c.location ? `<li>${enc(c.location)}</li>` : "",
    r.links.github ? `<li>${link("github", r.links.github)}</li>` : "",
    r.links.linkedin ? `<li>${link("linkedin", r.links.linkedin)}</li>` : "",
  ].join("");

  document.getElementById("resume").innerHTML = `
    <header>
      <h1>${enc(r.name)}</h1>
      ${r.tagline ? `<p class="job__org">${enc(r.tagline)}</p>` : ""}
      <ul class="contact">${contact}</ul>
    </header>
    <section><h2>Experience</h2>${renderExperience(r.experience || [])}</section>
    <section><h2>Research &amp; Community</h2>${renderResearch(r.research || [])}</section>
    <section><h2>Education</h2>${renderEducation(r.education || [])}</section>
    <section><h2>Skills</h2>${renderSkills(r.skills || {})}</section>`;

  document.getElementById("lock").hidden = true;
  document.getElementById("resume").hidden = false;
  document.getElementById("bar").hidden = false;
}

async function unlock(event) {
  event.preventDefault();
  const pw = document.getElementById("pw").value;
  const err = document.getElementById("err");
  err.hidden = true;
  if (!pw) return;

  let blob;
  try {
    const res = await fetch("contact.enc.json");
    if (!res.ok) throw new Error("load");
    blob = await res.json();
  } catch {
    err.hidden = false; err.textContent = "Could not load data.";
    return;
  }

  let contact;
  try {
    const material = await crypto.subtle.importKey(
      "raw", new TextEncoder().encode(pw), "PBKDF2", false, ["deriveBits"]);
    const bits = await crypto.subtle.deriveBits(
      { name: "PBKDF2", salt: b64ToBytes(blob.salt), iterations: blob.iterations, hash: "SHA-256" },
      material, 256);
    const key = await crypto.subtle.importKey("raw", bits, { name: "AES-GCM" }, false, ["decrypt"]);
    const plain = await crypto.subtle.decrypt(
      { name: "AES-GCM", iv: b64ToBytes(blob.nonce) }, key, cat(blob.ciphertext, blob.tag));
    contact = JSON.parse(new TextDecoder().decode(plain));
  } catch {
    err.hidden = false; err.textContent = "Wrong password.";
    return;
  }

  // Outside the decrypt try/catch on purpose: a render error must not read as
  // a bad password (that was the old bug).
  showResume(contact);
}

document.getElementById("lockform").addEventListener("submit", unlock);
</script>
</body>
</html>
